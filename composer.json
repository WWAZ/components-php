{
  "name": "wwaz/components-php",
  "type": "library",
  "description": "A PHP library for managing and rendering data-driven UI components",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "gajus/dindent": "^2.0",
    "respect/validation": "^2.0.17"
  },
  "autoload": {
    "psr-4": {
      "wwaz\\Components\\": "src/",
      "wwaz\\RespectValidationExtension\\": "src/RespectValidationExtension/",
      "Gajus\\Dindent\\": "vendor/gajus/dindent/src/"
    },
    "files": [
      "bootstrap/bootstrap.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "lint": "vendor/bin/php-cs-fixer fix --dry-run --diff --ansi",
    "format": "vendor/bin/php-cs-fixer fix --ansi",
    "stan": "vendor/bin/phpstan analyse --ansi",
    "qa": [
      "@lint",
      "@stan",
      "@test"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "friendsofphp/php-cs-fixer": "^3",
    "phpstan/phpstan": "^2.1"
  }
}
